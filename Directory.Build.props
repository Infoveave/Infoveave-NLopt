<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <Year>$([System.DateTime]::Today.Year)</Year>
    <Authors>Naresh Jois</Authors>
    <Company>Noesys Software Private Limited</Company>
    <Copyright>Copyright © 2020 - $(Year) Infoveave</Copyright>

    <PackageProjectUrl>https://github.com/Infoveave/Infoveave-NLopt</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Infoveave/Infoveave-NLopt.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>

    <ManagedPackageVersion>1.0.0-preview.1</ManagedPackageVersion>
    <NloptNativeVersion>2.11.0</NloptNativeVersion>
    <NloptRuntimeCompatibility>1</NloptRuntimeCompatibility>
    <Version>$(ManagedPackageVersion)</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>$(ManagedPackageVersion)+nlopt.$(NloptNativeVersion)</InformationalVersion>
    <PackageVersion>$(ManagedPackageVersion)</PackageVersion>
    <InfoveaveNloptNativeVersion>$(NloptNativeVersion)</InfoveaveNloptNativeVersion>
    <InfoveaveNloptRuntimeCompatibility>$(NloptRuntimeCompatibility)</InfoveaveNloptRuntimeCompatibility>
  </PropertyGroup>
</Project>

